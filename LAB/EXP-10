def transformation_tagger(words):

    tags = []

    for word in words:
        tags.append([word, "NN"])

    for i in range(1, len(tags)):
        if tags[i - 1][0].lower() == "to":
            tags[i][1] = "VB"

    return tags


sentence = "I want to play"

print(transformation_tagger(sentence.split()))
#OUTPUT
[['I', 'NN'],
 ['want', 'NN'],
 ['to', 'NN'],
 ['play', 'VB']]
