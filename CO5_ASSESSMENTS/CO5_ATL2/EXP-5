# Hybrid Machine Translation

source_sentence = "The boy is playing football."

# Step 1: Analyze source sentence
analysis = {
    "Agent": "Boy",
    "Action": "Play",
    "Object": "Football",
    "Tense": "Present",
    "Aspect": "Progressive"
}

# Step 2: Interlingua Representation
print("Interlingua Representation:")

for key, value in analysis.items():
    print(key + ":", value)

# Step 3: Candidate translations
candidates = {
    "బాలుడు ఫుట్‌బాల్ ఆడుతున్నాడు.": 0.95,
    "బాలుడు ఫుట్‌బాల్ ఆడుతాడు.": 0.70,
    "బాలుడు ఫుట్‌బాల్ ఆడాడు.": 0.40
}

# Step 4: Select translation with highest score
best_translation = max(candidates, key=candidates.get)

print("\nSource Sentence:")
print(source_sentence)

print("\nCandidate Translations:")
#OUTPUT
Interlingua Representation:
Agent: Boy
Action: Play
Object: Football
Tense: Present
Aspect: Progressive

Final Translation:
బాలుడు ఫుట్‌బాల్ ఆడుతున్నాడు.
for sentence, score in candidates.items():
    print(sentence, "Score:", score)

print("\nFinal Translation:")
print(best_translation)
